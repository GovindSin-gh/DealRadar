# Local dev uses SQLite automatically. For Supabase paste the Postgres connection string here.
DATABASE_URL=sqlite:///./dealradar.db
# Free key from console.groq.com. Leave empty to use the built-in fallback summary.
GROQ_API_KEY=
# Check the exact Qwen model id in your Groq console, it can change.
GROQ_MODEL=qwen/qwen3-32b
CACHE_HOURS=24
CORS_ORIGINS=*
# true = scrape real pages (Amazon.in only for now). false = built-in sample data.
LIVE_SCRAPING=false
# New (not cached) analyses allowed per visitor per hour.
RATE_LIMIT_PER_HOUR=5

# Price-drop emails (any SMTP provider; Gmail needs an App Password). Leave empty to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Public URL of this API, used in the unsubscribe link inside emails.
PUBLIC_API_URL=http://localhost:8000
WATCH_LIMIT_PER_HOUR=10
# Set to read GET /api/logs with header X-Admin-Token. Empty disables the endpoint.
ADMIN_TOKEN=

# Optional: load the model from another location.
# MODEL_PATH=

# Seconds to pause between shops pages in the daily job (only when LIVE_SCRAPING=true). Be polite.
DAILY_DELAY_SECONDS=3
# If page selectors fail, let Qwen read the title and price from the page text (checked against the text).
LLM_EXTRACT_FALLBACK=true

# Fetch these shops from a GitHub Actions worker instead of this server (use when the shop returns HTTP 429/403 to Render).
QUEUE_SHOPS=
GITHUB_REPO=
GITHUB_DISPATCH_TOKEN=
GITHUB_BRANCH=main
SCRAPE_WORKFLOW=scrape-on-demand.yml

# Shops visitors may analyze. Flipkart currently throttles automated requests (HTTP 529/429), so it is off by default.
# Set ENABLED_SHOPS=amazon,flipkart to switch it back on.
ENABLED_SHOPS=amazon
